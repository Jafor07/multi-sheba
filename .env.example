# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to browser

# Simple shared password for the /admin dashboard (Phase 2 — swap for real
# auth once you have more than one person managing orders)
ADMIN_PASSWORD=choose-a-strong-password
